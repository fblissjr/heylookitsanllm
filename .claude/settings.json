{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/models_toml_posttool.py",
            "timeout": 30,
            "statusMessage": "Validating models.toml"
          }
        ]
      }
    ]
  }
}
